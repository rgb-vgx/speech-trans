# Copy to .env and edit. Only the LLM key is required.
ST_HOST=127.0.0.1
ST_PORT=8787
ST_LOG_LEVEL=INFO

# --- LLM (translates the whole Udemy transcript once) -------------------
# Any Anthropic-compatible /v1/messages endpoint works.
ST_LLM_BASE_URL=https://opencode.ai/inference/go/anthropic/v1/messages
ST_LLM_API_KEY=
ST_LLM_MODEL=deepseek-v4.1-flash
ST_LLM_SESSION=speech-trans
ST_LLM_BATCH=20
ST_LLM_TIMEOUT=180

# --- Glossary -----------------------------------------------------------
# JSON file with terms that stay in English (see glossary.json).
ST_GLOSSARY_FILE=glossary.json
