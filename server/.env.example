# Copy to .env and edit. All settings are optional; defaults match an RTX 3060 12 GB.
ST_HOST=127.0.0.1
ST_PORT=8787
ST_LOG_LEVEL=INFO

# --- ASR ---------------------------------------------------------------
# "large-v3" (best) | "small" (less VRAM) | "medium"
ST_ASR_MODEL=large-v3
ST_ASR_DEVICE=cuda
ST_ASR_COMPUTE_TYPE=int8_float16
ST_ASR_LANGUAGE=en
# Comma-free hint with lecture vocabulary improves rare-word accuracy:
ST_ASR_INITIAL_PROMPT=

# --- Translation -------------------------------------------------------
ST_MT_MODEL=facebook/nllb-200-distilled-1.3B
ST_MT_DEVICE=cuda
ST_MT_DTYPE=float16
ST_MT_NUM_BEAMS=2
ST_GLOSSARY_FILE=glossary.json

# --- VAD ---------------------------------------------------------------
ST_VAD_THRESHOLD=0.5
ST_VAD_MIN_SPEECH_MS=250
ST_VAD_MIN_SILENCE_MS=350
ST_VAD_MAX_SEGMENT_S=12

# --- LLM (transcript mode: translate the whole transcript once) --------
ST_LLM_BASE_URL=https://opencode.ai/inference/go/anthropic/v1/messages
ST_LLM_API_KEY=
ST_LLM_MODEL=deepseek-v4.1-flash
ST_LLM_SESSION=speech-trans
ST_LLM_BATCH=20

# --- Runtime mode ------------------------------------------------------
# Transcript-only (default): no model preload, no live capture, no GPU.
ST_PRELOAD=false
ST_LIVE_ENABLED=false
# Fall back to the local NLLB model (GPU) when the LLM is rate-limited:
ST_LLM_FALLBACK=false
